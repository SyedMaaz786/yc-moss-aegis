# Moss credentials — free tier at https://moss.dev (sign up -> create a project -> copy these)
MOSS_PROJECT_ID=your_project_id_here
MOSS_PROJECT_KEY=your_project_key_here

# Groq API key (free tier, no card required) — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the model id (defaults to openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Optional participant gateway access from the HiDevs Credits tab.
HIDEVS_API_KEY=your_hidevs_virtual_key_here
HIDEVS_MODEL=gemini-3.5-flash-lite
# Primary: groq or hidevs. Backup: none, groq, or hidevs.
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=none

# Optional: local (default) uses the bundled encoder + native Moss sessions.
# cloud uses pre-seeded Moss Cloud indexes and their publisher model artifacts.
MOSS_RETRIEVAL_MODE=local
