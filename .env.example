# Moss credentials — free tier at https://moss.dev (sign up -> create a project -> copy these)
MOSS_PROJECT_ID=your_project_id_here
MOSS_PROJECT_KEY=your_project_key_here

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: override the model id (defaults to claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5
